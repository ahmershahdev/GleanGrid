APP_NAME=GleanGrid
# Local: APP_ENV=local, APP_DEBUG=true, APP_URL=http://127.0.0.1:8000
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://gleangrid.ahmershah.dev
# Pakistan Standard Time (the IANA zone is named after Karachi; it covers Hyderabad too).
APP_TIMEZONE=Asia/Karachi

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_CURRENCY=Rs

APP_MAINTENANCE_DRIVER=file

# Argon2id password hashing (memory-hard). Old bcrypt hashes are upgraded on next sign-in.
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_TIME=4
ARGON_THREADS=1

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gleangrid
DB_USERNAME=root
DB_PASSWORD=

# Database sessions let users see and revoke their devices (Profile → Sign-in & security).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
# Use "database" (with `php artisan queue:work`) in production so e-mail never slows a request.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Transactional e-mail (codes, order updates, security alerts, admin replies) ───
# Pick ONE provider. Local development: MAIL_MAILER=log (e-mails go to storage/logs/laravel.log).
#
# Option A — Resend (recommended; also receives e-mail, see RESEND_WEBHOOK_SECRET)
MAIL_MAILER=resend
RESEND_API_KEY=
# Signing secret (whsec_...) of the Resend webhook pointed at https://YOUR-DOMAIN/webhooks/resend/inbound
RESEND_WEBHOOK_SECRET=
#
# Option B — Sender.net transactional SMTP (Transactional → Setup instructions → SMTP)
# MAIL_MAILER=smtp
# MAIL_SCHEME=null
# MAIL_HOST=smtp.sender.net
# MAIL_PORT=587
# MAIL_USERNAME=          (the generated SMTP user, e.g. USER_xxxxxx)
# MAIL_PASSWORD=
#
# The From address must be on a domain you verified with the provider.
MAIL_FROM_ADDRESS="support@ahmershah.dev"
MAIL_FROM_NAME="${APP_NAME}"

SUPPORT_EMAIL=support@ahmershah.dev
SUPPORT_PHONE="+92 370 4831994"

# Google reCAPTCHA. Invisible v3 scores every guarded form; the visible challenge (v2 checkbox or
# Turnstile below) is required on sign-up/contact/password reset and on sign-in after a low score.
# In the reCAPTCHA admin console add localhost, 127.0.0.1 and your domain to BOTH keys.
# Leave everything empty to rely on the honeypot + signed form ticket only.
RECAPTCHA_V3_SITE_KEY=
RECAPTCHA_V3_SECRET_KEY=
RECAPTCHA_V2_SITE_KEY=
RECAPTCHA_V2_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
BOT_MIN_FORM_SECONDS=2
# A signed form ticket is issued with every page; forms older than this must be refreshed.
BOT_FORM_TTL_SECONDS=7200

# Cloudflare Turnstile (optional). When set it replaces the reCAPTCHA v2 checkbox as the visible
# challenge (CAPTCHA_CHALLENGE=recaptcha keeps Google's). Add your domain to the widget in the
# Cloudflare dashboard; the 1x00000000000000000000AA / 1x0000000000000000000000000000000AA pair
# are Cloudflare's always-pass test keys for local work.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CAPTCHA_CHALLENGE=turnstile
# If Google/Cloudflare can't be reached: true lets the form through (other layers still apply).
CAPTCHA_FAIL_OPEN=true

# ─── Online payments (Easypaisa, JazzCash, card) ───
# sandbox = built-in simulator (test cards shown on the payment page, no real money).
# live    = real gateways; only methods with credentials below are offered.
PAYMENTS_MODE=sandbox
PAYMENTS_WALLET_APPROVAL_SECONDS=4
# JazzCash hosted checkout (Merchant portal → Integration). Callback: https://YOUR-DOMAIN/payments/callback/jazzcash
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_ENDPOINT=https://sandbox.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform/

# ─── Sign in with Google / Facebook (buttons hide until both keys of a provider are set) ───
# Google Cloud Console → Credentials → OAuth client (Web). Redirect URI: https://YOUR-DOMAIN/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Meta for Developers → Facebook Login. Valid OAuth redirect URI: https://YOUR-DOMAIN/auth/facebook/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

VITE_APP_NAME="${APP_NAME}"

# Seeded evaluation accounts (…@gleangrid.test) are always verified and never e-mailed.
DEMO_EMAIL_DOMAIN=gleangrid.test

# Cross-Origin-Opener-Policy. Off by default: it prevents Lighthouse/PageSpeed from measuring performance.
SECURITY_COOP=false

TRUSTED_PROXIES=
