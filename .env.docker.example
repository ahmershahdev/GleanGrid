# Environment for `docker compose up`. Copy to .env.docker (git-ignored) and fill in APP_KEY.

APP_NAME=GleanGrid
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Karachi
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_CURRENCY=Rs

HASH_DRIVER=argon2id
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_DATABASE=gleangrid
DB_USERNAME=gleangrid
DB_PASSWORD=
# The MySQL container creates this database and user on first start (keep them equal to DB_*).
MYSQL_DATABASE=gleangrid
MYSQL_USER=gleangrid
# Same value as DB_PASSWORD
MYSQL_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Plain-HTTP localhost needs this false; set true behind HTTPS.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

MAIL_MAILER=log
MAIL_FROM_ADDRESS="support@ahmershah.dev"
MAIL_FROM_NAME="${APP_NAME}"
SUPPORT_EMAIL=support@ahmershah.dev

PAYMENTS_MODE=sandbox
CAPTCHA_FAIL_OPEN=true
DEMO_EMAIL_DOMAIN=gleangrid.test

# First boot only: fill an empty database with the demo markets, farmers and orders.
SEED_DEMO_DATA=true
